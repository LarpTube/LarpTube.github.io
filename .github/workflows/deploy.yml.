      - name: Fetch trending YouTube videos
        env:
          YOUTUBE_API_KEY: ${{ secrets.YOUTUBE_API_KEY }}
          YOUTUBE_REGION: "US"   # change to IE for Ireland, GB for UK, etc.
        run: |
          python3 - <<'EOF'
          import urllib.request, json, os

          key    = os.environ["YOUTUBE_API_KEY"]
          region = os.environ.get("YOUTUBE_REGION", "US")

          # Category IDs we want trending sections for (0 = overall trending)
          category_ids = ["0", "10", "20", "17", "23", "28"]
          seen = set()
          videos = []

          for cat_id in category_ids:
              url = (
                  "https://www.googleapis.com/youtube/v3/videos"
                  f"?key={key}"
                  f"&regionCode={region}"
                  f"&videoCategoryId={cat_id}"
                  "&chart=mostPopular"
                  "&part=snippet,contentDetails"
                  "&maxResults=12"
              )
              with urllib.request.urlopen(url) as r:
                  data = json.loads(r.read())

              for item in data.get("items", []):
                  vid_id = item["id"]
                  if vid_id in seen:
                      continue
                  seen.add(vid_id)
                  snip = item["snippet"]
                  videos.append({
                      "id":        vid_id,
                      "title":     snip["title"],
                      "category":  snip.get("categoryId", "0"),
                      "thumb":     snip["thumbnails"]["high"]["url"],
                      "channel":   snip["channelTitle"],
                      "published": snip["publishedAt"][:10],
                  })

          with open("videos.json", "w") as f:
              json.dump(videos, f)

          print(f"Wrote {len(videos)} trending videos to videos.json")
          EOF
