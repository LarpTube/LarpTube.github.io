name: Deploy LarpTube

on:
  push:
    branches: [main]
  workflow_dispatch:
  schedule:
    - cron: '0 */6 * * *'   # refresh video data every 6 hours

permissions:
  contents: write            # needs write to commit videos.json
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  fetch-and-deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Fetch YouTube videos
        env:
          YOUTUBE_API_KEY: ${{ secrets.YOUTUBE_API_KEY }}
          # Comma-separated channel IDs or a search query to populate your site
          YOUTUBE_CHANNEL_IDS: "UCxxxxYourChannelIDxxxx"
        run: |
          python3 - <<'EOF'
          import urllib.request, json, os

          key = os.environ["YOUTUBE_API_KEY"]
          channels = os.environ["YOUTUBE_CHANNEL_IDS"].split(",")
          videos = []

          for channel_id in channels:
              url = (
                  "https://www.googleapis.com/youtube/v3/search"
                  f"?key={key}&channelId={channel_id.strip()}"
                  "&part=snippet&order=date&maxResults=12&type=video"
              )
              with urllib.request.urlopen(url) as r:
                  data = json.loads(r.read())

              for item in data.get("items", []):
                  snip = item["snippet"]
                  vid_id = item["id"]["videoId"]
                  videos.append({
                      "id":        vid_id,
                      "title":     snip["title"],
                      "category":  snip.get("categoryId", ""),
                      "thumb":     snip["thumbnails"]["high"]["url"],
                      "channel":   snip["channelTitle"],
                      "published": snip["publishedAt"][:10],
                  })

          with open("videos.json", "w") as f:
              json.dump(videos, f)

          print(f"Wrote {len(videos)} videos to videos.json")
          EOF

      - name: Commit videos.json
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add videos.json
          git diff --cached --quiet || git commit -m "chore: refresh video data"
          git push

      - name: Configure Pages
        uses: actions/configure-pages@v5

      - name: Upload website
        uses: actions/upload-pages-artifact@v3
        with:
          path: .

      - name: Deploy website
        id: deployment
        uses: actions/deploy-pages@v4
